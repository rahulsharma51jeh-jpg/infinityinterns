# Copy to .env.local for local development.

# REQUIRED IN PRODUCTION — long random string used to sign session cookies.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional. Forces the origin used in QR codes and verification links.
# Leave unset to derive it from the incoming request (correct behind a proxy).
# NEXT_PUBLIC_SITE_URL=https://infinityinterns.com

# Optional. Directory holding portal.db — must be on a persistent writable disk.
# DATA_DIR=./data
